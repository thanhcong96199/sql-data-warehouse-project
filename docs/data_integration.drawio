        </mxCell>
        <mxCell id="grp_prd" value="Product Info" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;fontSize=13;" vertex="1" parent="1">
